rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return hasUserDoc() ? userDoc().role : null;
    }

    function isAdmin() {
      return isSignedIn() && (
        userRole() == "admin"
        || request.auth.token.email == "admin@dalhousie.app"
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin()
        || (!isSignedIn() && resource.data.usernameLower == "admin");

      allow create: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "faculty"
        && request.resource.data.user_status == "ACTIVE"
        && request.resource.data.keys().hasOnly([
          "uid",
          "username",
          "usernameLower",
          "email",
          "name",
          "fullName",
          "role",
          "user_status",
          "institution",
          "contactNumber",
          "mainTopics",
          "tutorials",
          "revision",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.revision == 1
      );

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (!("revision" in resource.data) && request.resource.data.revision == 1)
          || request.resource.data.revision == resource.data.revision + 1
        )
        && request.resource.data.keys().hasOnly([
          "uid",
          "username",
          "usernameLower",
          "email",
          "name",
          "fullName",
          "role",
          "user_status",
          "institution",
          "contactNumber",
          "mainTopics",
          "tutorials",
          "revision",
          "createdAt",
          "updatedAt"
        ])
      );

      allow delete: if isAdmin();
    }

    match /resourceDeletions/{resourceId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
        && request.resource.data.resourceId == resourceId
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "resourceId",
          "name",
          "file",
          "deletedBy",
          "deletedAt"
        ]);

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{collectionName}/{recordId} {
      allow read: if isSignedIn()
        && collectionName in [
          "members",
          "faculty",
          "fellows",
          "progress",
          "meetings",
          "minutes",
          "resources"
        ];

      allow create: if isAdmin()
        && collectionName in [
          "members",
          "faculty",
          "fellows",
          "progress",
          "meetings",
          "minutes",
          "resources"
        ]
        && request.resource.data.revision == 1
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isAdmin()
        && collectionName in [
          "members",
          "faculty",
          "fellows",
          "progress",
          "meetings",
          "minutes",
          "resources"
        ]
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;

      // Shared records use soft deletion so they remain recoverable.
      allow delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if (
          isAdmin()
          || (isSignedIn()
            && request.resource.data.entityType == "users"
            && request.resource.data.entityId == request.auth.uid)
        )
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.action in ["create", "update", "delete", "restore"]
        && request.resource.data.keys().hasOnly([
          "entityType",
          "entityId",
          "action",
          "revision",
          "actorId",
          "actorName",
          "timestamp",
          "before",
          "after"
        ]);
      allow update, delete: if false;
    }
  }
}
